{
  "schema_version": 1,
  "suites": {
    "verification-smoke": {
      "runner": "pytest",
      "cwd": ".",
      "timeout_seconds": 90,
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tools/verification/tests",
        "--junitxml={junit}"
      ],
      "state": "active"
    }
  }
}
